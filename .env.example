# GraphRAG Enterprise Engine - Environment Configuration

# Google Gemini API Key (Required for LLM inference & embeddings)
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily API Key (Optional: for CRAG web search fallback)
TAVILY_API_KEY=your_tavily_api_key_here

# Application Mode & Settings
ENV=development
API_PORT=8000
VECTOR_DB_DIR=./data/chroma_db
GRAPH_STORAGE_PATH=./data/knowledge_graph.json
CRAG_CONFIDENCE_THRESHOLD=0.65
EMBEDDING_MODEL=text-embedding-004
LLM_MODEL=gemini-2.5-flash
